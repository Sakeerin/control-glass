{
  "name": "control-glass",
  "version": "1.0.0",
  "description": "High-Trust Agentic Engineering Harness combining Michelin Kitchen (Dune, Control Glass, PAC) and The Bottleneck Moved (3-Phase Guardrails, Contracts, Tiered Review)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:dune": "tsx src/harness/dune-linter.ts",
    "guard:safety": "tsx src/harness/safety-gate.ts",
    "guard:tdd": "tsx src/harness/tdd-guard.ts",
    "test": "vitest run",
    "verify": "tsx src/harness/control-glass.ts",
    "review:diff": "tsx src/harness/diff-reviewer.ts",
    "lock:tests": "tsx src/harness/tdd-guard.ts --update-lock"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
