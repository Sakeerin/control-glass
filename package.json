{
  "name": "control-glass",
  "version": "2.0.0",
  "description": "High-Trust Agentic Engineering Plugin & CLI (Outperforming pstack with executable AST Deslop, Auto-Mapper, SHA-256 TDD Locks, Heap Benchmarks, and Tiered Review)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "control-glass": "./dist/harness/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "rules",
    "docs",
    "assets",
    "plugin.json",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint:dune": "tsx src/harness/dune-linter.ts",
    "deslop": "tsx src/harness/deslop.ts",
    "map": "tsx src/harness/auto-mapper.ts",
    "bench": "tsx src/harness/bench.ts",
    "install:hooks": "tsx src/harness/hook-installer.ts",
    "guard:safety": "tsx src/harness/safety-gate.ts",
    "guard:tdd": "tsx src/harness/tdd-guard.ts",
    "test": "vitest run",
    "verify": "tsx src/harness/control-glass.ts",
    "review:diff": "tsx src/harness/diff-reviewer.ts",
    "lock:tests": "tsx src/harness/tdd-guard.ts --update-lock",
    "cli": "tsx src/harness/cli.ts"
  },
  "keywords": [
    "ai-agent",
    "cursor-plugin",
    "antigravity-plugin",
    "control-glass",
    "dune-framework",
    "ast-linter",
    "tdd-lock"
  ],
  "dependencies": {
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  }
}
